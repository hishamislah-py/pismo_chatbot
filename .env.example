# Copy the settings you need into .env (same folder). Never commit .env; it is listed in .gitignore.

# --- AI pipeline (read by pismo_assistant via python-dotenv)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_S=60

# --- Local PostgreSQL in Docker (docker-compose.yml). Use long random values; never reuse real passwords.
PISMO_DB_SUPERUSER_PASSWORD=
PISMO_DB_APP_PASSWORD=
PISMO_DB_HOST_PORT=5434

# --- Backend database URL (SQLAlchemy, psycopg 3 driver)
# Optional: if DATABASE_URL is empty, the backend builds it from PISMO_DB_APP_PASSWORD / PISMO_DB_HOST_PORT:
#   postgresql+psycopg://pismo_app:<URL-encoded password>@<PISMO_DB_HOST>:<PISMO_DB_HOST_PORT>/pismo_assistant
# PISMO_DB_HOST defaults to 127.0.0.1 (IPv4); "localhost" can stall ~10 s per connection on Windows (tries ::1 first).
PISMO_DB_HOST=127.0.0.1
# Set it explicitly only to point elsewhere (the password part must be URL-encoded).
DATABASE_URL=
# Optional: a DISPOSABLE database for the PostgreSQL integration tests (its tables are dropped and recreated).
# Docker setup: postgresql+psycopg://pismo_app:<URL-encoded password>@127.0.0.1:5434/pismo_assistant_test
TEST_DATABASE_URL=

# --- Backend behaviour (defaults shown)
# Timeout budget: ASSISTANT_TIMEOUT_S is the deadline for the whole pipeline call. The backend gives each OpenAI attempt
# min(OPENAI_TIMEOUT_S, (ASSISTANT_TIMEOUT_S - 10) / (OPENAI_MAX_RETRIES + 1)) seconds, so every attempt fits the
# deadline (defaults: 40 s per attempt, 1 retry). The frontend waits 120 s and the Vite proxy 130 s.
ASSISTANT_TIMEOUT_S=90
OPENAI_MAX_RETRIES=1
# Answer-generation reasoning effort (not the router's). Empty = parameter not sent (the model default, the behaviour
# before this setting). Accepted: minimal, low. Read at backend start; restart the backend after changing it.
OPENAI_REASONING_EFFORT=
# First-stage routing classifier (backend/app/services/router.py): one call per message that the deterministic rules
# cannot decide, no retries, before any retrieval. ROUTER_MODEL defaults to OPENAI_MODEL; set a smaller model once its
# availability is verified. ROUTER_TIMEOUT_S + ASSISTANT_TIMEOUT_S must stay below the frontend's 120 s.
# ROUTER_ENABLED=false keeps rules-only routing (no classifier call).
ROUTER_ENABLED=true
ROUTER_MODEL=
ROUTER_TIMEOUT_S=8
ROUTER_REASONING_EFFORT=minimal
ASSISTANT_PRELOAD=true
CONTEXT_MAX_PRIOR_QUESTIONS=2
CONTEXT_MAX_CHARS=600
MAX_QUESTION_CHARS=2000
MAX_REQUEST_BYTES=16384
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
